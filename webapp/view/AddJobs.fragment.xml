<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" width="50%">
    <Dialog
        id="myDialog"
        title="Create Job"
        contentWidth="50%"
        afterClose=".onDialogClose">

        <VBox class="sapUiSmallMargin" >
            
            <Label text="Title"/>
            <Input id="titleInput" width="100%" placeholder="Enter title" required="true"/>

             <Label text="Skills"/>
            <MultiInput id="skillsInput" showSuggestion="false" placeholder="Enter skills and press Enter" width="100%" showValueHelp="false"/>

            <Label text="Description"/>
            <TextArea id="descInput" rows="8" width="100%" placeholder="Enter description" required="true"/>

           
        </VBox>

        <beginButton>
            <Button text="Save" type="Emphasized" press=".onSaveDialog"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
