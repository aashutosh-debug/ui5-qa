<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    controllerName="com.questionanswer.controller.Register"
>
    <App id="App-register">
        <Page id="RegisterPage">
            <headerContent>
                <core:Fragment
                    fragmentName="com.questionanswer.view.HeaderContent"
                    type="XML"
                />
            </headerContent>
            <content>
                <VBox
                    width="auto"
                    alignItems="Center"
                    class="sapUiLargeMarginTop"
                >
                    <Title
                        level="H3"
                        titleStyle="H2"
                        text="{i18n>companySignUp}"
                    />
                </VBox>
                <ToolbarSpacer />
                <VBox class="sapUiSmallMargin">
                    <f:SimpleForm
                        id="SimpleFormChange354"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3"
                        labelSpanL="3"
                        labelSpanM="3"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="4"
                        emptySpanL="4"
                        emptySpanM="4"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false"
                    >
                        <f:content>
                            <Label text="Company" />
                            <Input
                                id="companyName"
                                placeholder="Company Name"
                                required="true"
                                valueStateText="Company is required"
                            />
                            <Label text="Industry" />
                            <Input
                                id="industry"
                                placeholder="Industry"
                                required="true"
                            />
                            <Label text="Website" />
                            <Input
                                id="website"
                                placeholder="Website (optional)"
                            />
                            <Label text="Location" />
                            <Input
                                id="location"
                                placeholder="Location (City, Country)"
                                required="true"
                            />
                            <Label text="Contact Name" />
                            <Input
                                id="contactPerson"
                                placeholder="Contact Name"
                                required="true"
                            />
                            <Label text="Phone" />
                            <Input
                                id="phone"
                                placeholder="Phone Number"
                                type="Tel"
                                required="true"
                            />
                            <Label text="Email" />
                            <Input
                                id="email"
                                placeholder="Work Email"
                                type="Email"
                                required="true"
                            />
                            <Label text="Password" />
                            <Input
                                id="password"
                                placeholder="Password"
                                type="Password"
                                required="true"
                            />
                            <Label text="" />
                            <Button
                                text="SignUp"
                                type="Emphasized"
                                press="onSignUpPress"
                                class="sapUiSmallMarginTop"
                            />
                        </f:content>
                    </f:SimpleForm>
                </VBox>
            </content>
        </Page>
    </App>
</mvc:View>
