<mvc:View
    controllerName="com.questionanswer.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="page"
        showHeader="false"
    >
        <content>

            <VBox class="sapUiMediumMarginTop sapUiSmallMargin"
                    width="100%"
                    alignItems="Center"
                >
                    <Title
                        text="{i18n>smfs}"
                        level="H3"
                        titleStyle="H1"
                        wrapping="true"
                    />
                    <Text
                        text="{i18n>sample}"
                        textAlign="Center"
                    />
                </VBox>
                
            <!-- <FlexBox
                wrap="Wrap"
                justifyContent="Center"
                class="sapUiMediumMarginTop sapUiMediumMarginBottom"
            >
                <items>
                    <Title
                        level="H3"
                        titleStyle="H1"
                        text="{i18n>smfs}"
                    />
                    <ToolbarSpacer />
                    <Text text="{i18n>sample}" />
                </items>
            </FlexBox> -->
            <FlexBox
                wrap="Wrap"
                justifyContent="Center"
                class="sapUiMediumMarginTop sapUiLargeMarginBottom"
            >
                <items>
                    <GenericTile
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>candidateLogin}"
                        press="onCandidateLogin"
                    >
                    <TileContent>
                        <ImageContent src="/css/login.png" />
                    </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>candidateSignUp}"
                        press="onCandidateRegister"
                    >
                    <TileContent>
                        <ImageContent src="/css/signup.png" />
                    </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>companyLogin}"
                        press="onLogin"
                    >
                    <TileContent>
                        <ImageContent src="/css/login.png" />
                    </TileContent>
                    </GenericTile>
                    <GenericTile
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>companySignUp}"
                        press="onRegister"
                    >
                    <TileContent>
                        <ImageContent src="/css/signup.png" />
                    </TileContent>
                    </GenericTile>
                </items>
            </FlexBox>

            <!-- Value Proposition -->
            <HBox
                justifyContent="SpaceAround"
                width="100%"
                class="sapUiLargeMarginBottom"
            >
                <VBox
                    width="30%"
                    alignItems="Center"
                >
                    <Title
                        text="For Candidates"
                        level="H3"
                    />
                    <Text
                        text="Showcase your skills with AI reports."
                        textAlign="Center"
                    />
                </VBox>
                <VBox
                    width="30%"
                    alignItems="Center"
                >
                    <Title
                        text="For Recruiters"
                        level="H3"
                    />
                    <Text
                        text="Save 80% screening time with AI shortlists."
                        textAlign="Center"
                    />
                </VBox>
                <VBox
                    width="30%"
                    alignItems="Center"
                >
                    <Title
                        text="For Both"
                        level="H3"
                    />
                    <Text
                        text="Fair. Fast. Intelligent."
                        textAlign="Center"
                    />
                </VBox>
            </HBox>
        </content>
        <!-- Footer -->
        <!-- <footer>
            <Toolbar
                design="Info"
                class="sapUiSmallMarginTop"
            >
                <ToolbarSpacer />
                <Button
                    text="Terms"
                    type="Transparent"
                />
                <Button
                    text="Privacy"
                    type="Transparent"
                />
                <Button
                    text="Support"
                    type="Transparent"
                />
                <ToolbarSpacer />
            </Toolbar>
        </footer> -->
    </Page>
</mvc:View>
