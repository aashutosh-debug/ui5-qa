<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" width="50%">
    <Dialog
        id="myDialogCS"
        title="Contact Support"
        contentWidth="50%"
        afterClose=".onDialogClose">

        <VBox class="sapUiSmallMargin" >
            
            <Label text="Title"/>
            <Input id="subject" width="100%" placeholder="Enter subject" required="true"/>

            <Label text="Description"/>
            <TextArea id="description" rows="8" width="100%" placeholder="Enter description" required="true"/>

            <!-- <Label text="Tags"/>
            <MultiInput id="tagsInput" showSuggestion="false" placeholder="Enter tags and press Enter" width="100%" showValueHelp="false"/> -->

        </VBox>

        <beginButton>
            <Button text="Save" type="Emphasized" press=".onSaveDialog"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
