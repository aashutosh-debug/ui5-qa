<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    controllerName="com.questionanswer.controller.ResetPassword"
>
    <App id="app-RP">
        <Page
            id="LoginPage"
        >
            <headerContent>
              <Image src="../css/talent.png" width="2rem"></Image>
                <Title
                    text="{i18n>companyName}"
                    level="H3"
                    class="sapUiTinyMarginEnd"
                />
                <ToolbarSpacer />

            </headerContent>
            
            <content>
                <FlexBox
                    height="auto"
                    alignItems="Stretch"
                    direction="Column"
                    justifyContent="Center"
                    class="sapUiLargeMargin"
                >
                    <Title
                        titleStyle="H3"
                        text="Reset password"
                    />
                    <Label
                        text="Enter Password:"
                        class="sapUiSmallMarginTop"
                    />
                    <Input
                        id="password"
                        placeholder="Enter Password"
                        type="Password"
                        required="true"
                        width="18rem"
                    />
                    <Label
                        text="Confirm Password:"
                        class="sapUiSmallMarginTop"
                    />
                    <Input
                        id="confirmPassword"
                        placeholder="Confirm Password"
                        type="Password"
                        required="true"
                        width="18rem"
                    />
                    <Button
                        text="Reset"
                        class="sapUiSmallMarginTop"
                        type="Emphasized"
                        press="onResetPassword"
                    />
                </FlexBox>
                
            </content>
        </Page>
    </App>
</mvc:View>
