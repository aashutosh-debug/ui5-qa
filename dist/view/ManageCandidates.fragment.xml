<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:t="sap.ui.table" width="50%">
                <t:Table
                    id="manageCandidatesTable"
                    rows="{candidatesModel>/rows}"
                    selectionMode="MultiToggle"
                    ariaLabelledBy="title"
                    visibleRowCount="5"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <ToolbarSpacer />
                             <Button
                                text="SEND FOR TEST"
                                tooltip="Send selected candidates for Test"
                                press=".onSendCandidateForTest"
                            />
                            <Button
                                icon="sap-icon://add"
                                tooltip="Refresh"
                                press=".onAddCandidateToJob"
                            />
                            <Button
                                icon="sap-icon://refresh"
                                tooltip="Refresh"
                                press=".onRefreshCandidates"
                            />
                            <Button
                                icon="sap-icon://delete"
                                press=".onDeleteCandidates"
                            />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width="auto">
                            <Label text="Candidate" />
                            <t:template>
                                <Input
                                    type="email"
                                    value="{candidatesModel>email}"
                                    liveChange="onEmailLiveChange"
                                    valueState="{candidatesModel>valueState}"
                                    enabled="{= ${candidatesModel>status} === 'Draft' }"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="6rem">
                            <Label text="Scores" />
                            <t:template>
                                <Text
                                    text="{candidatesModel>score}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="6rem">
                            <Label text="Status" />
                            <t:template>
                                <Text
                                    text="{candidatesModel>status}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <!-- <t:Column width="8rem">
                            <Label text="" />
                            <t:template>
                                <Button
                                    text="Send For Test"
                                />
                            </t:template>
                        </t:Column> -->
                    </t:columns>
                </t:Table>
</core:FragmentDefinition>
