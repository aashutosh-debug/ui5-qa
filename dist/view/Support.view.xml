<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    controllerName="com.questionanswer.controller.Support"
>
    <App id="app-Support">
        <Page
            id="SupportPage"
            class="sapUiContentPadding"
        >
        <headerContent>
               <Toolbar design="Transparent" width="100%">
                <Image src="../css/talent.png" width="2rem"></Image>
                <Title
                    text="{i18n>companyName}"
                    level="H3"
                    class="sapUiTinyMarginEnd"
                />
                <ToolbarSpacer />
                <Button
                    text="Logout"
                    type="Transparent"
                    press=".onLogout"
                />
            </Toolbar>
            </headerContent>
            <content>
                <t:Table
                    id="table"
                    rows="{supportModel>/rows}"
                    selectionMode="None"
                    ariaLabelledBy="title"
                    
                >
                 <t:extension>
                        <OverflowToolbar style="Clear">
                            <!-- <Title text="Tickets"/> -->
                            <ToolbarSpacer />
                            <Button
                                type="Emphasized"
                                text="Contact Support"
                                tooltip="Contact Support"
                                press=".onCreateSupportTicket"
                            />
                            <Button
                                icon="sap-icon://refresh"
                                tooltip="Refresh"
                                press=".onRefreshSupportTicket"
                            />
                        </OverflowToolbar>
                    </t:extension>
                    <t:columns>
                        <t:Column>
                            <Label text="id" />
                            <t:template>
                                <Text
                                    text="{supportModel>id}"
                                    wrapping="true"
                                    tooltip="{supportModel>id}"
                                />
                            </t:template>
                        </t:Column>
						<t:Column>
                            <Label text="Subject" />
                            <t:template>
                                <Label
                                    text="{supportModel>subject}"
                                    wrapping="true"
                                    design="Bold"
                                    tooltip="{supportModel>subject}"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column>
                            <Label text="Description" />
                            <t:template>
                                <Text
                                    text="{supportModel>description}"
                                    wrapping="true"
                                    tooltip="{supportModel>description}"
                                />
                            </t:template>
                        </t:Column>
						<t:Column>
                            <Label text="Status" />
                            <t:template>
                                <Text
                                    text="{supportModel>status}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
						<t:Column>
                            <Label text="Created At" />
                            <t:template>
                                <Text
                                    text="{supportModel>created_at}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
						<!-- <t:Column width="50px" hAlign="Center">
                            <Label text="" />
                            <t:template>
                                 <Button icon="sap-icon://navigation-right-arrow" type="Transparent" press=".openQuestionView"/>
                            </t:template>
                        </t:Column> -->
                    </t:columns>
                </t:Table>
            </content>
        </Page>
    </App>
</mvc:View>
