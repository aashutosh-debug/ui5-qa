<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" width="50%">
    <Dialog
        id="qDialog"
        title="Create Questions"
        contentWidth="50%"
        afterClose=".onDialogClose">

        <VBox class="sapUiSmallMargin" >
            
            <Label text="Enter Question"/>
            <TextArea id="questionInput" width="100%" placeholder="Enter title" required="true"/>

            <Label text="Enter Question"/>
            <Select
                id="questionType"
				forceSelection="false"
				selectedKey="mcq"
                width="30%">
					<core:Item key="mcq" text="MCQ's" />
			</Select>

            <Label text="Options"/>
            <MultiInput id="optionsInput" showSuggestion="false" placeholder="Enter Options and press Enter" width="100%" showValueHelp="false"/>

            <Label text="Answers"/>
            <MultiInput id="answersInput" showSuggestion="false" placeholder="Enter Answers and press Enter" width="100%" showValueHelp="false"/>

        </VBox>

        <beginButton>
            <Button text="Save" type="Emphasized" press=".onSaveQuestionsDialog"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
