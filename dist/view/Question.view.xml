<mvc:View
    xmlns:uxap="sap.uxap"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    controllerName="com.questionanswer.controller.Question"
>
    <uxap:ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="false"
        headerContentPinnable="true"
        isChildPage="true"
        upperCaseAnchorBar="false"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:expandedHeading>
                    <HBox>
                        <Title
                            text="{title}"
                            wrapping="true"
                        />
                    </HBox>
                </uxap:expandedHeading>

                <uxap:snappedHeading>
                    <FlexBox
                        fitContainer="true"
                        alignItems="Center"
                    >
                        <Title
                            text="{title}"
                            wrapping="true"
                        />
                    </FlexBox>
                </uxap:snappedHeading>

                <uxap:expandedContent>
                    <Text text="{id}" />
                </uxap:expandedContent>

                <uxap:snappedContent>
                    <Text text="{id}" />
                </uxap:snappedContent>

                <uxap:snappedTitleOnMobile>
                    <Title text="{id}" />
                </uxap:snappedTitleOnMobile>
                <uxap:actions>
                    <!-- <Button
                        text="Edit"
                        type="Emphasized"
                        visible="{= !${questionModel>/editable} }"
                        press=".onEditPress"
                    /> -->
                    <!-- <Button
                        text="Save"
                        type="Emphasized"
                        visible="{= ${questionModel>/editable} }"
                        press=".onCancelPress"
                    /> -->
                    <!-- <Button
                        text="Cancel"
                        type="Transparent"
                        visible="{= ${questionModel>/editable} }"
                        press=".onCancelPress"
                    /> -->
                    <!-- <Button
                        text="Delete"
                        type="Transparent"
                        visible="{= !${questionModel>/editable} }"
                        press=".onDeleteJob"
                    /> -->
                    <OverflowToolbarButton type="Emphasized" icon="sap-icon://edit" press="onEditPress" id="editJob" tooltip="Edit Job" visible="{= !${questionModel>/editable} }" />
                    <OverflowToolbarButton type="Emphasized" icon="sap-icon://save" press="onSavePress" id="saveJob" tooltip="Edit Job" visible="{= ${questionModel>/editable} }" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://cancel" press="onCancelPress" id="cancelSaveJob" tooltip="Cancel"  visible="{= ${questionModel>/editable} }" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://delete" press="onDeleteJob" id="deleteJob" tooltip="Delete Job" visible="{= !${questionModel>/editable} }" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://full-screen" press="handleFullScreen" id="enterFullScreenBtn" tooltip="Enter Full Screen Mode" visible="{= !${questionModel>/midColumnFullScreen} }" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://exit-full-screen" press="handleExitFullScreen" id="exitFullScreenBtn" tooltip="Exit Full Screen Mode" visible="{= ${questionModel>/midColumnFullScreen} }" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://decline" press="handleClose" id="closeQuestion" tooltip="Close"  />
                    <!-- <Button
                        type="Transparent"
                        icon="sap-icon://decline" 
                        tooltip="Close middle column"
                        press=".handleClose"
                    /> -->
                    <!-- <Button
                        text="Copy"
                        type="Transparent"
                        visible="{= !${questionModel>/editable} }"
                    /> -->
                    <!-- <Button
						icon="sap-icon://action"
						type="Transparent"/> -->
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:sections>
            <uxap:ObjectPageSection title="Job Details">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <form:SimpleForm
                                id="displayJobDetails"
                                editable="false"
                                layout="ResponsiveGridLayout"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="3"
                                labelSpanS="12"
                                adjustLabelSpan="false"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                singleContainerFullSize="false"
                                visible="{= !${questionModel>/editable} }"
                            >
                                <form:content>
                                    <Label text="Job Title" />
                                    <Text text="{title}" />
                                     <Label text="Skills"/>
                                    <Text text="{skills}" />

                                    <!-- <MultiInput id="skillsInputQ"  editable="false" showSuggestion="false" placeholder="Enter skills and press Enter" width="100%" showValueHelp="false"/> -->
                                    <Label text="Job Description" />
                                    <Text text="{description}" />
                                </form:content>
                            </form:SimpleForm>
                            <form:SimpleForm
                                id="changeJobDetails"
                                editable="false"
                                layout="ResponsiveGridLayout"
                                labelSpanXL="3"
                                labelSpanL="3"
                                labelSpanM="3"
                                labelSpanS="12"
                                adjustLabelSpan="false"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                columnsXL="1"
                                columnsL="1"
                                columnsM="1"
                                singleContainerFullSize="false"
                                visible="{questionModel>/editable}"
                            >
                                <form:content>
                                    <Label text="Job Title" />
                                    <Input id="titleInputForm"  value="{title}" />
                                     <Label text="Skills"/>
                                    <MultiInput id="skillsInputQC" editable="true" showSuggestion="false" placeholder="Enter skills and press Enter" width="100%" showValueHelp="false"/>
                                    <Label text="Job Description" />
                                    <TextArea id="descInputForm" rows="10" value="{description}" />
                                </form:content>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection title="Questions">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <t:Table
                                id="questionsTable"
                                rows="{jobQuestionModel>/}"
                                selectionMode="MultiToggle"
                                ariaLabelledBy="title"
                                visibleRowCount="5"
                            >
                                <t:extension>
                                    <OverflowToolbar style="Clear">
                                        
                                        <ToolbarSpacer />
                                        <Button
                                            icon="sap-icon://add"
                                            type="Emphasized"
                                            tooltip="Add Questions"
                                            press=".onCreateQuestionOpenDialog"
                                        />
                                        <Button
                                            icon="sap-icon://ai"
                                            tooltip="Generate 10 Questions using AI"
                                            press=".onGenerateQuestionUsingAI"
                                        />
                                        <Button
                                            icon="sap-icon://refresh"
                                            tooltip="Refresh"
                                            press=".onRefresh"
                                        />
                                        <Button 
                                            icon="sap-icon://delete" 
                                            press=".onDeleteQuestions"/>
                                    </OverflowToolbar>
                                </t:extension>

                                <t:columns>
                                    <t:Column width="11rem">
                                        <Label text="Question" />
                                        <t:template>
                                            <Text
                                                text="{jobQuestionModel>question_text}"
                                                wrapping="false"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="auto">
                                        <Label text="Options" />
                                        <t:template>
                                            <Text
                                                text="{jobQuestionModel>options}"
                                                wrapping="false"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="auto">
                                        <Label text="Answers" />
                                        <t:template>
                                            <Text
                                                text="{jobQuestionModel>answers}"
                                                wrapping="false"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="auto">
                                        <Label text="Type" />
                                        <t:template>
                                            <Text
                                                text="{jobQuestionModel>question_type}"
                                                wrapping="false"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <!-- <t:Column width="6rem">
                                        <Label text="" />
                                        <t:template>
                                            <HBox>
                                                <Button icon="sap-icon://delete" class="sapUiTinyMarginBegin"/>
                                            </HBox>
                                        </t:template>
                                    </t:Column> -->
                                </t:columns>
                            </t:Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
             <uxap:ObjectPageSection title="Candidates">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                        <uxap:blocks>
                            <!-- <VBox>
                                <Text text="Click Manage Candidates button to View/Add Candidates for this Job. This will appear in candidates portal to take test."></Text>
                                <Button text="Manage Candidates" type="Emphasized" press="onNavigateToManageCandidatesCompany" class="sapUiSmallMarginTop"></Button>
                            </VBox> -->
                            <core:Fragment
                                fragmentName="com.questionanswer.view.ManageCandidates"
                                type="XML"
                            />

                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
