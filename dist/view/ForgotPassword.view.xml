<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="com.questionanswer.controller.ForgotPassword"
>
    <App id="app-FPLogin">
        <Page id="FPPage">
            <headerContent>
                <Image
                    src="../css/talent.png"
                    width="2rem"
                />
                <Title
                    text="{i18n>companyName}"
                    level="H3"
                    class="sapUiTinyMarginEnd"
                />
                <ToolbarSpacer />
            </headerContent>

            <content>
                <FlexBox
                    height="auto"
                    alignItems="Stretch"
                    direction="Column"
                    justifyContent="Center"
                    class="sapUiLargeMargin"
                >
                    <Title
                        titleStyle="H3"
                        text="Forgot my password"
                    />
                    <Label
                        text="Enter your email id:"
                        class="sapUiSmallMarginTop"
                    />
                    <Input
                        id="email"
                        placeholder="Work Email"
                        type="Email"
                        required="true"
                        width="18rem"
                    />
                    <Button
                        text="Continue"
                        class="sapUiSmallMarginTop"
                        type="Emphasized"
                        press="onContinue"
                    />
                </FlexBox>
            </content>
        </Page>
    </App>
</mvc:View>
